# ==============================
# GENERAL APP SETTINGS
# ==============================
APP_NAME=klima-api
APP_MODE=development
APP_PORT=8000
TOKEN_EXPIRETIME=60
LOG_LEVEL=ERROR
SECRET_KEY=replace-with-your-own-secret
DB_DIALECT=sqlite # postgres, sqlite, mssql, oracle
PURGE=FALSE

# ==============================
# POSTGRES (DEFAULT PRODUCTION)
# ==============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=klima
POSTGRES_USER=klima_user
POSTGRES_PASSWORD=supersecret

# ==============================
# SQLITE (LOCAL DEV / BACKUP)
# ==============================
SQLITE_FILE=local.db

# ==============================
# MYSQL (OPTIONAL)
# ==============================
MYSQL_HOST=localhost
MYSQL_PORT=1433
MYSQL_DB=klima
MYSQL_USER=sa
MYSQL_PASSWORD=supersecret

# ==============================
# SUPABASE (OPTIONAL CLOUD AUTH / DB)
# ==============================
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_DB_URL=postgresql+asyncpg://user:pass@db.supabase.co:5432/dbname
SUPABASE_CLIENT_ID=your-supabase-client-id
SUPABASE_SECRET=your-supabase-secret

# ==============================
# SOCIAL AUTH PROVIDERS
# Prefix: SOCIAL_*
# ==============================
# FACEBOOK
SOCIAL_FB_CLIENT_ID=fb-client-id
SOCIAL_FB_CLIENT_SECRET=fb-client-secret

# GOOGLE
SOCIAL_GOOGLE_CLIENT_ID=google-client-id
SOCIAL_GOOGLE_CLIENT_SECRET=google-client-secret

# GITHUB
SOCIAL_GITHUB_CLIENT_ID=github-client-id
SOCIAL_GITHUB_CLIENT_SECRET=github-client-secret

# ==============================
# OIDC / FULL AUTH PROVIDERS
# Prefix: AUTH_*
# ==============================
# AUTH0
AUTH0_CLIENT_ID=auth0-client-id
AUTH0_CLIENT_SECRET=auth0-client-secret
AUTH0_DOMAIN=your-tenant.auth0.com

# KEYCLOAK
KEYCLOAK_CLIENT_ID=keycloak-client-id
KEYCLOAK_CLIENT_SECRET=keycloak-client-secret
KEYCLOAK_URL=https://keycloak-host
KEYCLOAK_REALM=master

# ==============================
# FIREBASE (OPTIONAL, AUTH ONLY)
# ==============================
FIREBASE_PROJECT_ID=firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-client-email@project.iam.gserviceaccount.com

# ==============================
# JWT SETTINGS
# ==============================
JWT_SECRET_KEY=replace-with-your-own-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ==============================
# OPTIONAL: REDIS / CACHING
# ==============================
REDIS_URL=redis://localhost:6379/0
